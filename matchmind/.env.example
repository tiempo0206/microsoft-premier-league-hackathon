# Copy to .env locally. Read via your chosen dotenv loader; never commit the real file.
MATCHMIND_MODEL_PROVIDER=mock
MATCHMIND_MODEL_BASE_URL=https://REPLACE_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MATCHMIND_MODEL_NAME=qwen-plus
MATCHMIND_MODEL_API_KEY=
MATCHMIND_MODEL_TIMEOUT_SEC=12
MATCHMIND_MAX_CONCURRENT_ANALYSES=1
MATCHMIND_MAX_REPLAY_SESSIONS=8
MATCHMIND_ANALYSIS_LIMIT_PER_HOUR=30
# Backend execution toggles are implemented by Role B/C, not by the mock server.
