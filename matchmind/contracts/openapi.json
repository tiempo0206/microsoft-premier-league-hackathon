  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "Window": {
        "type": "object",
        "properties": {
          "start_sec": {
            "type": "integer",
            "minimum": 0
          },
          "end_sec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "start_sec",
          "end_sec"
        ],
        "additionalProperties": false
      },
      "Counts": {
        "type": "object",
        "properties": {
          "HOME": {
            "type": "integer",
            "minimum": 0
          },
          "AWAY": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "HOME",
          "AWAY"
        ],
        "additionalProperties": false
      },
      "Match": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "string",
            "minLength": 1
          },
          "home": {
            "type": "string",
            "minLength": 1
          },
          "away": {
            "type": "string",
            "minLength": 1
          },
          "synthetic": {
            "const": true
          },
          "clip_start_sec": {
            "type": "integer",
            "minimum": 0
          },
          "clip_end_sec": {
            "type": "integer",
            "minimum": 0
          },
          "period": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "home_attack_direction": {
            "type": "string",
            "enum": [
              "right",
              "left"
            ]
          },
          "initial_possession_team": {
            "type": "string",
            "enum": [
              "HOME",
              "AWAY"
            ]
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "generator_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "match_id",
          "home",
          "away",
          "synthetic",
          "clip_start_sec",
          "clip_end_sec",
          "period",
          "home_attack_direction",
          "initial_possession_team",
          "seed",
          "generator_version"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "match_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_sec": {
            "type": "integer",
            "minimum": 0
          },
          "period": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "pass",
              "recovery",
              "shot",
              "goal",
              "foul"
            ]
          },
          "team_id": {
            "type": "string",
            "enum": [
              "HOME",
              "AWAY"
            ]
          },
          "player_id": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          },
          "end_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "successful",
              "failed",
              "on_target",
              "off_target",
              "goal",
              "none"
            ]
          },
          "possession_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "event_id",
          "match_id",
          "timestamp_sec",
          "period",
          "type",
          "team_id",
          "player_id",
          "position",
          "end_position",
          "outcome",
          "possession_id"
        ],
        "additionalProperties": false
      },
      "MatchState": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "string",
            "minLength": 1
          },
          "at_sec": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "$ref": "#/components/schemas/Counts"
          },
          "shots": {
            "$ref": "#/components/schemas/Counts"
          },
          "passes": {
            "$ref": "#/components/schemas/Counts"
          },
          "completed_passes": {
            "$ref": "#/components/schemas/Counts"
          },
          "possession_seconds": {
            "$ref": "#/components/schemas/Counts"
          },
          "last_event_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "match_id",
          "at_sec",
          "score",
          "shots",
          "passes",
          "completed_passes",
          "possession_seconds",
          "last_event_id"
        ],
        "additionalProperties": false
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "high_recoveries": {
            "type": "integer",
            "minimum": 0
          },
          "linked_shots": {
            "type": "integer",
            "minimum": 0
          },
          "window_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "home_possession_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "away_possession_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "home_shots": {
            "type": "integer",
            "minimum": 0
          },
          "away_shots": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "high_recoveries",
          "linked_shots",
          "window_seconds",
          "home_possession_seconds",
          "away_possession_seconds",
          "home_shots",
          "away_shots"
        ],
        "additionalProperties": false
      },
      "Replay": {
        "type": "object",
        "properties": {
          "replay_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "integer",
            "minimum": 1
          },
          "match_id": {
            "type": "string",
            "minLength": 1
          },
          "clock_sec": {
            "type": "integer",
            "minimum": 0
          },
          "speed": {
            "type": "integer",
            "enum": [
              1,
              2,
              5,
              10
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "playing",
              "paused",
              "ended"
            ]
          },
          "last_seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "replay_id",
          "run_id",
          "match_id",
          "clock_sec",
          "speed",
          "status",
          "last_seq"
        ],
        "additionalProperties": false
      },
      "CreateReplay": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "string",
            "minLength": 1
          },
          "speed": {
            "type": "integer",
            "enum": [
              1,
              2,
              5,
              10
            ]
          }
        },
        "required": [
          "match_id",
          "speed"
        ],
        "additionalProperties": false
      },
      "ControlReplay": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "play",
                  "pause",
                  "reset"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "set_speed"
              },
              "speed": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  5,
                  10
                ]
              }
            },
            "required": [
              "action",
              "speed"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Trace": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "enum": [
              "analyst",
              "narrator",
              "auditor",
              "validator"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed",
              "rejected",
              "failed",
