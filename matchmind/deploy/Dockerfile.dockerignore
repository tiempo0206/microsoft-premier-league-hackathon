# Deny by default; Dockerfile-specific context filter for the backend image.
**
!backend/
backend/**
!backend/*.py
!backend/requirements.lock
!contracts/
contracts/**
!contracts/*.py
!contracts/*.json
!contracts/VERSION
!data/
data/**
!data/fixtures/
data/fixtures/**
!data/fixtures/*.json
!data/fixtures/*.jsonl
!data/extra/
data/extra/**
!data/extra/validated-demo/
data/extra/validated-demo/**
!data/extra/validated-demo/*.json
!data/extra/validated-demo/*.jsonl
!data/extra/validated-demo/README.md
!data/extra/showcase/
!data/extra/showcase/*/
!data/extra/showcase/*/*.json
!data/extra/showcase/*/*.jsonl
!data/generator/
data/generator/**
!data/generator/*.py
!deploy/
deploy/**
!deploy/Dockerfile
!deploy/__init__.py
!deploy/preflight.py
