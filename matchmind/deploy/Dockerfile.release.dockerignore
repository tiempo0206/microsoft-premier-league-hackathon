# Release context remains deny-by-default, even with private local credentials.
**
!backend/
!backend/*.py
!backend/requirements.lock
!contracts/
!contracts/*.py
!contracts/*.json
!contracts/VERSION
!data/
!data/fixtures/
!data/fixtures/*.json
!data/fixtures/*.jsonl
!data/extra/
!data/extra/validated-demo/
!data/extra/validated-demo/*.json
!data/extra/validated-demo/*.jsonl
!data/extra/showcase/
!data/extra/showcase/*/
!data/extra/showcase/*/*.json
!data/extra/showcase/*/*.jsonl
!data/generator/
!data/generator/*.py
!ai/
!ai/*.py
!ai/requirements.txt
!frontend/
!frontend/dist/
!frontend/dist/**
frontend/dist/**/.env*
frontend/dist/**/*.pem
frontend/dist/**/*.key
!deploy/
!deploy/__init__.py
!deploy/preflight.py
!deploy/release_check.py
!deploy/release_run.py
!deploy/adapter_check.py
!deploy/requirements-release.lock
!deploy/Dockerfile.release
