# Backend-only configuration. Export these values in the process/platform environment.
# The app intentionally does not auto-load arbitrary .env files.
PORT=8000
MATCHMIND_DATA_DIR=data/extra/validated-demo
MATCHMIND_SERVE_FRONTEND=0
MATCHMIND_MAX_REPLAY_SESSIONS=8
MATCHMIND_MAX_SUBSCRIBERS_PER_REPLAY=4
MATCHMIND_SSE_QUEUE_SIZE=64
MATCHMIND_SESSION_TTL_SEC=1800
MATCHMIND_MAX_REQUEST_BYTES=16384
MATCHMIND_ANALYSIS_LIMIT_PER_HOUR=30
MATCHMIND_MAX_CONCURRENT_ANALYSES=1
MATCHMIND_ANALYSIS_QUEUE_SIZE=8
MATCHMIND_MODEL_TIMEOUT_SEC=12
# Analysis dispatch starts only when an async adapter is explicitly injected.
# No model API key, frontend token or database credential is required.
