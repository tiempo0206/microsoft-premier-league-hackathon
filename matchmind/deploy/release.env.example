# Integrator-owned runtime choices. This file contains placeholders, never keys.
PORT=10000
MATCHMIND_SERVE_FRONTEND=1
# Enable showcase/press only after deploy.adapter_check passes with reviewed C.
MATCHMIND_DATA_DIR=data/extra/validated-demo
MATCHMIND_MAX_REPLAY_SESSIONS=8
MATCHMIND_MAX_CONCURRENT_ANALYSES=1
MATCHMIND_ANALYSIS_LIMIT_PER_HOUR=30
# Candidate 20-second shared deadline from C's measurements; remeasure on host.
MATCHMIND_MODEL_TIMEOUT_SEC=20
# Must be observed in actual traces before claiming Microsoft Agent Framework use.
MATCHMIND_ORCHESTRATOR=framework
MATCHMIND_THINKING=disabled
# Default stays offline. C/integrator opts into a real provider explicitly.
MATCHMIND_MODEL_PROVIDER=mock
MATCHMIND_MODEL_BASE_URL=
MATCHMIND_MODEL_NAME=
MATCHMIND_MODEL_API_KEY=
